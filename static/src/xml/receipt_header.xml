<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

  <t t-name="l10n_ar_pos_einvoice_ticket.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">

    <!-- Centrar solo el separador del cashier, no el nombre -->
    <xpath expr="//div[hasclass('cashier')]/div[1]" position="attributes">
      <attribute name="class">text-center</attribute>
    </xpath>

    <!-- Ocultar tracking number cuando hay número de factura -->
    <xpath expr="//span[hasclass('tracking-number')]/.." position="attributes">
      <attribute name="t-if">props.data.trackingNumber and !props.data.bigTrackingNumber and !props.data.invoice_number</attribute>
    </xpath>
    <xpath expr="//h1[hasclass('tracking-number')]" position="attributes">
      <attribute name="t-if">props.data.trackingNumber and props.data.bigTrackingNumber and !props.data.invoice_number</attribute>
    </xpath>

    <!-- Información AFIP empresa (después de la empresa) -->
    <xpath expr="//t[@t-if='props.data.company.vat']" position="replace">
      <div class="afip-info">
        <t t-if='props.data.invoice_number'>
          <div>CUIT: <t t-if="props.data.company_parent" t-esc="props.data.company_parent.vat"/>
          <t t-else="" t-esc="props.data.company.vat"/>
        </div>
        <div>Ing. Brutos: <t t-if="props.data.company_parent" t-esc="props.data.company_parent.l10n_ar_gross_income_number"/>
        <t t-else="" t-esc="props.data.company.l10n_ar_gross_income_number"/>
      </div>
      <div>Inicio de actividades: <t t-if="props.data.company_parent" t-esc="props.data.company_parent.l10n_ar_afip_start_date"/>
      <t t-else="" t-esc="props.data.company.l10n_ar_afip_start_date"/>
    </div>
    <div>
            Dirección:
      <t t-esc="props.data.company.street"/>
      <t t-if="props.data.company.city">
              ,        <t t-esc="props.data.company.city"/>
      </t>
      <t t-if="props.data.company.state_id">
              ,        <t t-esc="props.data.company.state_id.name"/>
      </t>
      <t t-if="props.data.company.country_id">
              ,        <t t-esc="props.data.company.country_id.name"/>
      </t>
    </div>
    <t t-if="props.data.company.l10n_ar_afip_responsibility_type_id">
      <div>
        <t t-esc="props.data.company.l10n_ar_afip_responsibility_type_id.name"/>
      </div>
    </t>
  </t>
</div>
</xpath>

<!-- Número de factura y datos del cliente -->
<xpath expr="//div[@class='pos-receipt-contact']" position="after">
<t t-if='props.data.invoice_number and props.data.config.receipt_invoice_number'>
  <div class="afip-invoice-info">
    <div class="text-center">--------------------------------</div>
    <strong>
      <t t-esc="props.data.l10n_latam_document_name"/>
            - ORIGINAL
      <t t-if="props.data.invoice_letter == 'A'">
              - COD <t t-esc="props.data.l10n_latam_document_type_id"/>
      </t>
      <br />
            N° DE FACTURA: <t t-esc="props.data.invoice_number"/>
    <br />
            FECHA: <t t-esc="props.data.invoice_date"/>
  </strong>
  <div class="text-center">--------------------------------</div>
</div>
</t>
<t t-if='props.data.partner and props.data.config.receipt_customer_vat'>
<div class="afip-client-info">
  <div>CLIENTE: <t t-esc='props.data.partner.name' />
  </div>
  <t t-if='props.data.invoice_number'>
    <t t-if="props.data.partner.vat and props.data.partner.vat?.trim() !== ''">
      <div>
        <t t-if="props.data.partner.l10n_latam_identification_type_id">
          <t t-esc="props.data.partner.l10n_latam_identification_type_id.name"/>
:
        </t>
        <t t-else="">Doc.:</t>
        <t t-esc="props.data.partner.vat"/>
      </div>
    </t>
    <t t-if="props.data.partner.l10n_ar_afip_responsibility_type_id and props.data.partner.name !='Consumidor Final'">
      <div>
        <t t-esc='props.data.partner.l10n_ar_afip_responsibility_type_id.name' />
      </div>
    </t>
  </t>
  <t t-if="props.data.partner.street">
    <div>
              CALLE: <t t-esc="props.data.partner.street"/>
    <t t-if="props.data.partner.city">
                ,      <t t-esc="props.data.partner.city"/>
    </t>
    <t t-if="props.data.partner.state_id">
                ,      <t t-esc="props.data.partner.state_id.name"/>
    </t>
    <t t-if="props.data.partner.country_id">
                ,      <t t-esc="props.data.partner.country_id.name"/>
    </t>
  </div>
  <t t-if="props.data.partner.email">
    <div>Email: <t t-esc="props.data.partner.email"/>
    </div>
  </t>
  <t t-if="props.data.partner.phone or props.data.partner.mobile">
    <div>Tel: <t t-esc="props.data.partner.phone || props.data.partner.mobile"/>
    </div>
  </t>
  <t t-if="props.data.partner.website">
    <div>Website: <t t-esc="props.data.partner.website"/>
    </div>
  </t>
</t>
</div>
</t>
<br/>
<!-- Header de columnas condicional por letra de factura -->
<strong class="afip-col-header">
  <t t-if="props.data.invoice_letter == 'A'">
    <div style="display:flex; justify-content:space-between;">
      <span>DESCRIPCIÓN</span>
      <span style="text-align:right;">% IVA&#160;&#160;IMPORTE</span>
    </div>
    <div>CANT. x PRECIO UNIT.</div>
  </t>
  <t t-else="">
    <div>DESCRIPCIÓN</div>
    <div>
      CANT. x PRECIO UNIT.
      <span class="price_display pos-receipt-right-align">IMPORTE</span>
    </div>
  </t>
</strong>
</xpath>

  </t>

</templates>
